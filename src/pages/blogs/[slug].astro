---
import '../../styles/blogs.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CommercialBlogBody from '../../components/blogs/CommercialBlogBody.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCommercialBlogPost, getCommercialBlogPosts } from '../../data/blogs/posts';
import { articleSchema, breadcrumbSchema, faqPageSchema, parseBlogDate } from '../../utils/schema';
import { CARD_IMAGE_WIDTHS } from '../../utils/responsiveImage';

export function getStaticPaths() {
  return getCommercialBlogPosts().map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = slug ? getCommercialBlogPost(slug) : undefined;
if (!post) {
  return Astro.redirect('/404');
}

const pagePath = `/blogs/${post.slug}/`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blogs', path: '/blogs/' },
  { name: post.title, path: pagePath },
];
const publishedLabel = new Date(post.published).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={post.seoTitle}
  description={post.seoDescription}
  ogImage={post.ogImage}
  ogImageAlt={post.imageAlt}
  ogType="article"
  articlePublishedTime={parseBlogDate(post.published)}
  articleModifiedTime={parseBlogDate(post.modified)}
  jsonLd={[
    articleSchema({
      name: post.seoTitle,
      headline: post.title,
      description: post.seoDescription,
      url: pagePath,
      image: post.ogImage,
      datePublished: parseBlogDate(post.published),
      dateModified: parseBlogDate(post.modified),
    }),
    breadcrumbSchema(breadcrumbs),
    faqPageSchema(post.faqs.map((f) => ({ q: f.q, a: f.a }))),
  ]}
>
  <article class="blogs-article py-8 md:py-12">
    <div class="mx-auto max-w-3xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="mt-6 space-y-4">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">{post.category}</p>
        <h1 class="text-3xl font-bold leading-tight md:text-4xl">{post.title}</h1>
        <p class="text-sm text-muted-foreground">
          <span>By Call of Duty Cheats</span>
          <span aria-hidden="true"> · </span>
          <time datetime={post.published}>{publishedLabel}</time>
          <span aria-hidden="true"> · </span>
          <span>{post.readTime}</span>
        </p>
      </header>
      <figure class="mt-8 overflow-hidden rounded-2xl border border-border">
        <ResponsiveImage
          src={post.image}
          alt={post.imageAlt}
          width={post.heroWidth}
          height={post.heroHeight}
          widths={CARD_IMAGE_WIDTHS}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-video w-full object-cover"
        />
      </figure>
      <div class="mt-10">
        <CommercialBlogBody post={post} />
      </div>
    </div>
  </article>
</BaseLayout>
