---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../utils/schema';
import { buyerReviews, REVIEW_SUMMARY } from '../data/reviews';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];

const jsonLd = [
  breadcrumbSchema(breadcrumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: 'Call of Duty cheats for PC',
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: REVIEW_SUMMARY.average,
      reviewCount: REVIEW_SUMMARY.total,
      bestRating: REVIEW_SUMMARY.bestRating,
      worstRating: REVIEW_SUMMARY.worstRating,
    },
    review: buyerReviews.slice(0, 12).map((r) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: r.author },
      datePublished: r.date,
      reviewBody: r.text,
      reviewRating: {
        '@type': 'Rating',
        ratingValue: r.rating,
        bestRating: REVIEW_SUMMARY.bestRating,
        worstRating: REVIEW_SUMMARY.worstRating,
      },
    })),
  },
];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="mt-6 max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">{t.reviews.eyebrow}</p>
        <h1 class="text-3xl font-bold md:text-4xl">{t.reviews.title}</h1>
        <p class="text-lg text-muted-foreground">{t.reviews.subtitle}</p>
        <p class="text-sm text-muted-foreground" aria-live="polite">
          <span class="font-semibold text-foreground">{REVIEW_SUMMARY.average.toFixed(1)}</span> average from{' '}
          <span class="font-semibold text-foreground">{REVIEW_SUMMARY.total}</span> buyer ratings on file — showing{' '}
          {buyerReviews.length} recent write-ups below.
        </p>
      </header>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {buyerReviews.map((review) => (
          <li class="rounded-2xl border border-border bg-card/70 p-5 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-semibold text-foreground">{review.author}</p>
                <p class="text-xs text-muted-foreground">{review.role}</p>
              </div>
              <p class="text-sm font-bold text-primary" aria-label={`Rated ${review.rating} out of 5`}>
                {'★'.repeat(review.rating)}
                <span class="sr-only">{review.rating} out of 5</span>
              </p>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{review.text}</p>
            <time class="mt-4 block text-xs text-muted-foreground" datetime={review.date}>
              {review.date}
            </time>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>