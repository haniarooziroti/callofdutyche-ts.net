---
import '../styles/reviews.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../utils/schema';
import { buyerReviews, REVIEW_SUMMARY } from '../data/reviews';

const seo = resolvePageSeo('/reviews/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];

const starFill = (rating: number) =>
  Array.from({ length: 5 }, (_, i) => (i < rating ? '★' : '☆')).join('');

const jsonLd = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout title={seo.title} description={seo.description} jsonLd={jsonLd}>
  <section class="reviews-page py-8 md:py-12">
    <div class="mx-auto max-w-4xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="mt-6 space-y-2">
        <h1 class="text-3xl font-bold md:text-4xl">Call of Duty cheat reviews</h1>
        <p class="text-base leading-relaxed text-muted-foreground">{t.reviews.subtitle}</p>
      </header>

      <div class="reviews-summary reviews-summary--rich" aria-label="Average buyer rating">
        <div class="reviews-summary__score">
          <div>
            <p class="reviews-summary__value">
              {REVIEW_SUMMARY.average.toFixed(1)} <span class="text-lg text-muted-foreground">/ 5</span>
            </p>
            <p class="reviews-summary__label">Average rating</p>
          </div>
          <p class="reviews-stars" aria-hidden="true">
            {starFill(Math.round(REVIEW_SUMMARY.average))}
          </p>
        </div>
        <div class="reviews-histogram" aria-hidden="true">
          {[5, 4, 3, 2, 1].map((stars) => {
            const pct = stars === 5 ? 52 : stars === 4 ? 31 : stars === 3 ? 12 : stars === 2 ? 4 : 1;
            return (
              <div class="reviews-histogram__row">
                <span>{stars}★</span>
                <span class="reviews-histogram__track">
                  <span class="reviews-histogram__fill" style={`width: ${pct}%`} />
                </span>
              </div>
            );
          })}
        </div>
        <p class="reviews-summary__count">
          <strong class="text-foreground">{REVIEW_SUMMARY.total}</strong> reviews
        </p>
      </div>

      <div class="reviews-toolbar">
        <label>
          Sort by
          <select data-reviews-sort aria-label="Sort reviews">
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="rating-high">Highest rating</option>
            <option value="rating-low">Lowest rating</option>
          </select>
        </label>
        <label>
          Filter reviews
          <select data-reviews-filter aria-label="Filter reviews by rating">
            <option value="all">All ratings</option>
            <option value="5">5 stars</option>
            <option value="4">4 stars</option>
            <option value="3">3 stars</option>
          </select>
        </label>
      </div>
      <p class="reviews-toolbar__meta" data-reviews-count aria-live="polite">
        {buyerReviews.length} reviews shown
      </p>

      <ul class="reviews-list" data-reviews-list>
        {buyerReviews.map((review) => (
          <li
            class="reviews-card"
            data-review-card
            data-rating={review.rating}
            data-date={review.date}
          >
            <div class="reviews-card__head">
              <div class="reviews-card__who">
                <b>{review.author}</b>
                <span>{review.role}</span>
              </div>
              <div class="reviews-card__meta">
                <p class="reviews-stars" aria-label={`${review.rating} out of 5`}>
                  {starFill(review.rating)}
                </p>
                <time datetime={review.date}>{review.date}</time>
              </div>
            </div>
            <p class="reviews-card__quote">{review.text}</p>
            <p class="reviews-card__tag">Modules · PC</p>
          </li>
        ))}
      </ul>
      <p class="reviews-empty hidden" data-reviews-empty>No reviews match this filter.</p>
    </div>
  </section>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('[data-review-card]')];
    const sortEl = document.querySelector<HTMLSelectElement>('[data-reviews-sort]');
    const filterEl = document.querySelector<HTMLSelectElement>('[data-reviews-filter]');
    const countEl = document.querySelector<HTMLElement>('[data-reviews-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-reviews-empty]');
    const list = document.querySelector<HTMLElement>('[data-reviews-list]');

    function updateReviews() {
      const sort = sortEl?.value ?? 'newest';
      const filter = filterEl?.value ?? 'all';
      const ranked = [...cards].sort((a, b) => {
        const dateA = a.dataset.date ?? '';
        const dateB = b.dataset.date ?? '';
        const ratingA = Number(a.dataset.rating);
        const ratingB = Number(b.dataset.rating);
        if (sort === 'oldest') return dateA.localeCompare(dateB);
        if (sort === 'rating-high') return ratingB - ratingA || dateB.localeCompare(dateA);
        if (sort === 'rating-low') return ratingA - ratingB || dateB.localeCompare(dateA);
        return dateB.localeCompare(dateA);
      });

      let visible = 0;
      ranked.forEach((card) => {
        const rating = card.dataset.rating ?? '';
        const show = filter === 'all' || rating === filter;
        card.hidden = !show;
        if (show) {
          visible += 1;
          list?.append(card);
        }
      });

      if (countEl) countEl.textContent = `${visible} review${visible === 1 ? '' : 's'} shown`;
      emptyEl?.classList.toggle('hidden', visible > 0);
    }

    sortEl?.addEventListener('change', updateReviews);
    filterEl?.addEventListener('change', updateReviews);
    updateReviews();
    document.addEventListener('astro:page-load', updateReviews);
  </script>
</BaseLayout>