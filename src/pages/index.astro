---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo, canonicalUrl } from '../config/seo';
import ShareButtons from '../components/ShareButtons.astro';
import { organizationSchema, websiteSchema } from '../utils/schema';
import { SEO_MEDIA } from '../config/media';
const seo = resolvePageSeo('/');
const heroLcpImage = SEO_MEDIA.heroPoster;
const shareUrl = canonicalUrl('/');
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImageAlt="Call of Duty cheats ESP overlay on Multiplayer"
  jsonLd={[websiteSchema(), organizationSchema()]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
  <div class="mx-auto max-w-6xl px-5 pb-12">
    <ShareButtons shareUrl={shareUrl} shareText={seo.title} />
  </div>
</BaseLayout>
