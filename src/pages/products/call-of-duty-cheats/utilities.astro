--- import '../../../styles/product-cheat-page.css'; import BaseLayout from '../../../layouts/BaseLayout.astro'; import { productHub, productPages } from '../../../data/products'; import { resolvePageSeo } from '../../../config/seo'; import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../utils/schema'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import { productPath } from '../../../utils/path'; import { Button } from '@/components/starwind/button'; import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card'; import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow, } from '@/components/starwind/table'; const utilities = productPages.filter((p) => p.kind === 'utility' && p.slug !== 'appeals'); const utilitiesPath = '/products/call-of-duty-cheats/utilities/'; const seo = resolvePageSeo(utilitiesPath); const breadcrumbs = [ { name: 'Home', path: '/' }, { name: 'Products', path: productHub.path }, { name: 'Compare utilities', path: utilitiesPath }, ]; const utilityUseCases: Record<string, string> = { 'hwid-spoofer': 'New PC or hardware flag after a ban—reset how your machine appears before a new account.', ugc: 'Listed here only as a catalog link. The write-up lives on the account appeals page.', 'cloud-dma': 'Optional external memory read path—second PC, firmware, and cabling expectations before hardware checkout.', }; --- <BaseLayout title={seo.title} description={seo.description} jsonLd={[ webPageSchema({ name: 'Compare Call of Duty utilities', description: seo.description, url: utilitiesPath, }), breadcrumbSchema(breadcrumbs), itemListSchema( utilities.map((product) => ({ name: product.title, url: productPath(product.slug), })), ), ]} > <section class="py-8 md:py-12"> <div class="mx-auto max-w-6xl px-5"> <Breadcrumbs items={breadcrumbs} /> <header class="mt-6 max-w-3xl space-y-3"> <h1 class="text-3xl font-bold md:text-4xl">Call of Duty utilities for HWID and DMA</h1> <p class="text-lg text-muted-foreground"> This hub lists the HWID spoofer and Cloud DMA next to the cheat catalog. Account appeals stay on their own page. </p> <p class="text-sm text-muted-foreground"> <a href="/products/call-of-duty-cheats/appeals/" class="text-primary underline-offset-4 hover:underline">account appeals workspace</a> <span aria-hidden="true"> · </span> <a href="/products/call-of-duty-cheats/" class="text-primary underline-offset-4 hover:underline">Module lists and checkout</a> <span aria-hidden="true"> · </span> <a href="/blogs/buy-cod-cheats/" class="text-primary underline-offset-4 hover:underline">how checkout works</a> <span aria-hidden="true"> · </span> <a href="/" class="text-primary underline-offset-4 hover:underline">cheat features on the homepage</a> </p> </header> <div class="mt-10 rounded-lg border border-border" tabindex="0" aria-label="Utility comparison"> <Table> <TableHeader> <TableRow> <TableHead>Utility</TableHead> <TableHead>Best for</TableHead> <TableHead>Product page</TableHead> </TableRow> </TableHeader> <TableBody> {utilities.map((product) => ( <TableRow> <TableCell class="font-medium">{product.title}</TableCell> <TableCell class="text-muted-foreground">{utilityUseCases[product.slug] ?? product.desc}</TableCell> <TableCell> <a href={productPath(product.slug)} class="text-primary hover:underline"> Open {product.title} specs and checkout </a> </TableCell> </TableRow> ))} </TableBody> </Table> </div> <ul class="mt-10 space-y-4"> {utilities.map((product) => ( <li> <Card> <CardHeader> <CardTitle class="text-lg normal-case"> <a href={productPath(product.slug)} class="hover:text-primary">{product.title}</a> </CardTitle> </CardHeader> <CardContent class="space-y-2 text-sm text-muted-foreground"> <p>{product.desc}</p> <p> <strong class="text-foreground">Includes:</strong>{' '} {product.features.slice(0, 4).join(' · ')} {product.more > 0 ? ` · +${product.more} more` : ''} </p> </CardContent> </Card> </li> ))} </ul> <div class="mt-10"> <Button as="a" href={productHub.path} variant="outline">Return to product hub</Button> </div> </div> </section> </BaseLayout> 