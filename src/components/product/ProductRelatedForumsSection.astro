---
import type { ForumPost } from '../../data/forum';
import SectionHeader from '../SectionHeader.astro';
import { Button } from '@/components/starwind/button';
import Icon from '../icons/Icon.astro';
import { ROUTES } from '../../utils/path';

interface Props {
  posts: ForumPost[];
  productName: string;
}

const { posts, productName } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="border-t border-border bg-muted/20 py-16 md:py-24" aria-labelledby="related-forum-heading">
      <div class="mx-auto max-w-6xl px-5">
        <SectionHeader
          eyebrow="Community"
          title={`Forum threads about ${productName}`}
          desc="Setup questions, aimbot tuning, ESP layouts, and patch-day notes from other Call of Duty players."
          titleId="related-forum-heading"
        />

        <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {posts.map((post) => (
            <li>
              <a
                href={`/forum/${post.slug}/`}
                class="group flex h-full flex-col rounded-2xl border border-border/80 bg-card/60 p-5 transition hover:border-primary/40"
              >
                <span class="text-xs font-medium uppercase tracking-wide text-primary">{post.category}</span>
                <h3 class="mt-2 text-base font-semibold leading-snug group-hover:text-primary">{post.title}</h3>
                <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{post.excerpt}</p>
                <span class="mt-4 text-sm text-muted-foreground">{post.commentsCount} replies</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex justify-start lg:justify-center">
          <Button as="a" href={ROUTES.forum} variant="outline" class="rounded-full">
            Browse the forum
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}
