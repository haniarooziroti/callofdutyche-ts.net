---
import type { ProductPage } from '../../data/products';
import Icon from '../icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
---

<header class="product-detail-header space-y-4">
  <div class="flex flex-wrap items-center gap-2">
    <Badge variant="secondary">{product.badge}</Badge>
    {product.variant === 'popular' && <Badge>Popular</Badge>}
    {product.variant === 'limited' && <Badge variant="warning">Limited</Badge>}
    <Badge variant="outline">Call of Duty PC</Badge>
    <Badge variant="outline" class="gap-1.5">
      <Icon name="shieldCheck" size={13} class="icon-app--primary" />
      Status-checked build
    </Badge>
  </div>
  <h1 class="max-w-3xl text-3xl font-bold normal-case leading-tight md:text-4xl">{product.title}</h1>
  <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{product.subtitle || product.desc}</p>
  {product.slug === 'appeals' && (
    <p class="max-w-2xl text-sm">
      <a class="text-primary underline-offset-4 hover:underline" href="/products/call-of-duty-cheats/">product catalog</a>
      <span aria-hidden="true"> · </span>
      <a class="text-primary underline-offset-4 hover:underline" href="/blogs/buy-cod-cheats/">store checkout steps</a>
      <span aria-hidden="true"> · </span>
      <a class="text-primary underline-offset-4 hover:underline" href="/products/call-of-duty-cheats/utilities/">utilities hub</a>
      <span aria-hidden="true"> · </span>
      <a class="text-primary underline-offset-4 hover:underline" href="/">feature overview</a>
    </p>
  )}
</header>
