---
import '../styles/product-cheat-page.css';
import { t } from '../i18n';
import { getCatalogCards } from '../data/catalog';
import SectionHeader from './SectionHeader.astro';
import CatalogCard from './CatalogCard.astro';
const s = t.products;
const catalogProducts = getCatalogCards();
---

<section id="products" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="products-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={s.eyebrow} title={s.title} desc={s.subtitle} titleId="products-title" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        catalogProducts.map((product) => {
          const cardTitle = product.cardTitle ?? product.title;
          return (
            <CatalogCard
              label={product.label}
              title={cardTitle}
              href={product.href}
              buyUrl={product.buyUrl}
              features={product.features}
              more={product.more}
              icon={product.icon}
              badge={product.badge}
              variant={product.variant}
              extraBadges={product.extraBadges}
              buyLabel="Checkout"
              viewLabel={`Open ${cardTitle}`}
              maxFeatures={4}
            />
          );
        })
      }
    </div>
  </div>
</section>
