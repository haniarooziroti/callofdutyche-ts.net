---
import { t } from '../i18n';
import type { BlogPost } from '../i18n/types';
import { blogTagIcons } from '../data/sectionIcons';
import ResponsiveImage from './ResponsiveImage.astro';
import { CARD_IMAGE_SIZES, CARD_IMAGE_WIDTHS } from '../utils/responsiveImage';
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';

interface Props {
  post: BlogPost;
  index?: number;
  showDate?: boolean;
}

const { post, showDate = true } = Astro.props;
const tagIcon: IconName = blogTagIcons[post.tag] ?? 'tag';
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-border/80 bg-card shadow-sm transition-shadow hover:shadow-md">
  <a href={`/blogs/${post.slug}/`} class="block overflow-hidden">
    <ResponsiveImage
      src={post.image}
      alt={post.title}
      width={640}
      height={360}
      widths={CARD_IMAGE_WIDTHS}
      sizes={CARD_IMAGE_SIZES}
      loading="lazy"
      class="aspect-video w-full object-cover transition-transform duration-300 hover:scale-[1.02]"
    />
  </a>
  <div class="flex flex-1 flex-col p-5">
    <Badge variant="secondary" size="sm" class="w-fit gap-1 rounded-full">
      <Icon name={tagIcon} size={12} />
      {post.tag}
    </Badge>
    <h2 class="mt-2 text-lg font-semibold leading-snug">
      <a href={`/blogs/${post.slug}/`} class="hover:text-primary">
        {post.title}
      </a>
    </h2>
    <p class="mt-2 flex-1 text-sm text-muted-foreground">{post.desc}</p>
    {
      showDate && (
        <p class="mt-3 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          <Icon name="calendar" size={13} />
          {post.date}
          <span aria-hidden="true">·</span>
          <Icon name="clock" size={13} />
          {post.readTime}
        </p>
      )
    }
    <a
      href={`/blogs/${post.slug}/`}
      class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
    >
      {t.blog.read}
      <Icon name="arrowRight" size={15} />
    </a>
  </div>
</article>
