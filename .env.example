# Production canonical origin (required for sitemap and meta).
# PUBLIC_SITE_ORIGIN=https://cod-cheats.net

# Google Analytics 4 — set your real ID for Buy now checkout_click events (build time).
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Worker can override the built-in meta at runtime (optional).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional Organization sameAs profiles (comma-separated URLs).
# PUBLIC_ORG_SAME_AS=https://x.com/yourprofile

# Optional IndexNow key filename host validation.
# INDEXNOW_KEY=