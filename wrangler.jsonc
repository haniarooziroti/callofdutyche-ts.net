{
  "name": "cod-che-ts-net",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "npm ci && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
